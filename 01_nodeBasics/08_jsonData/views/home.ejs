<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.name %> - Instagram Profile</title>
<body>
      <h2>this page belongs to @<%= data.name %></h2> 
      <button>follow</button> 
      <button>message</button>
      
      <p>followers : <%= data.followers %></p>
      <p>following : <%= data.following %></p>

      <hr>
      <h3>Posts</h3>
      <% for(let post of data.posts){ %>
        <img src="<%= post.image %>" alt="post" width="200px" height="200px">
        <h4>caption: <%= post.caption %></h4>
        <h4>like: <%= post.likes %></h4>
        <h4>comments: <%= comments %></h4>
        <h4>timestamp: <%= post.timestamp %></h4>
      <% } %>
      
</body>
</html>
