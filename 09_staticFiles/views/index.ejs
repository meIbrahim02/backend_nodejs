<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Landing Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="page-shell">
        <header class="topbar">
            <div class="brand">Nova</div>
            <nav class="nav">
                <a href="#">Home</a>
                <a href="#">About</a>
                <a href="#">Projects</a>
                <a href="#">Contact</a>
            </nav>
            <button class="hire-btn">Hire me</button>
        </header>

        <main class="hero">
            <section class="profile-copy">
                <p class="eyebrow">Product Designer & Developer</p>
                <h1>Hi, I’m Alex Morgan.</h1>
                <p class="lead">
                    I build thoughtful digital experiences that blend clean design,
                    strong UX, and modern web technology.
                </p>

                <div class="cta-row">
                    <a href="#" class="primary-btn">View Portfolio</a>
                    <a href="#" class="secondary-btn">Book a Call</a>
                </div>

                <div class="stats">
                    <div>
                        <strong>5+</strong>
                        <span>Years Experience</span>
                    </div>
                    <div>
                        <strong>32</strong>
                        <span>Projects Delivered</span>
                    </div>
                    <div>
                        <strong>12k</strong>
                        <span>Design Followers</span>
                    </div>
                </div>
            </section>

            <aside class="profile-card">
                <div class="avatar">AM</div>
                <h2>Alex Morgan</h2>
                <p class="role">UI/UX Designer</p>

                <ul class="info-list">
                    <li><span>Location</span><strong>San Francisco, CA</strong></li>
                    <li><span>Email</span><strong>alex@nova.studio</strong></li>
                    <li><span>Focus</span><strong>Brand Systems</strong></li>
                </ul>
            </aside>
        </main>
    </div>

    <script src="app.js"></script>
</body>
</html>